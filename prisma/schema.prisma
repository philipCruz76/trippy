generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @unique @default(uuid())
  email         String    @unique
  image         String?
  name          String?
  username      String?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at")
  emailVerified Boolean?
  accounts      Account[]
  trips         Trip[]
  chats         Chat[]
}

model Trip {
  id          String    @id @default(uuid())
  title       String
  location    String
  duration    Int
  description String?
  userId      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  itinerary   TripDay[]
  chats       Chat[]    
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TripDay {
  id          String         @id @default(uuid())
  dayNumber   Int
  title       String?
  comment     String?        @db.Text
  activities  TripActivity[]
  tripId      String
  trip        Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model TripActivity {
  id              String    @id @default(uuid())
  title           String
  cover           String?
  manualInput     Boolean?  @default(false)
  activityType    String?
  durationFrom    String?
  durationTo      String?
  tripDayId       String
  tripDay         TripDay   @relation(fields: [tripDayId], references: [id], onDelete: Cascade)
}

model Place {
  id          String          @id @default(uuid())
  name        String
  type        String?
  description String?
  address     String?
  userRating  String?
  ratingCount String?
  images      UnsplashImage[]
}

model UnsplashImage {
  id          String          @id @default(uuid())
  url         String
  description String?
  placeId     String
  aspect      Int?
  creatorId   String
  creator     UnsplashCreator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  place       Place           @relation(fields: [placeId], references: [id], onDelete: Cascade)
}

model UnsplashCreator {
  id          String          @id @default(uuid())
  username    String
  profileLink String
  images      UnsplashImage[]
}


model Account {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  type              String
  provider          String
  providerAccountId String   @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Destinations {
  id         BigInt   @id @default(autoincrement())
  created_at DateTime @default(now()) @db.Timestamptz(6)
  city       String?  @unique
  country    String?
  photo      String?
}

// Chat and related models
model Chat {
  id            String    @id @default(uuid())
  userId        String    
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  keywords      Json      // Stores KeywordClassificationsType
  location      Json      // Stores LatLngResult
  summary       String    @db.Text
  trip          Trip?     @relation(fields: [tripId], references: [id])
  tripId        String?
  days          ChatDay[]
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChatDay {
  id          String    @id @default(uuid())
  title       String
  description String    @db.Text
  activities  Activity[]
  chatId      String
  chat        Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
}

model Activity {
  id              String    @id @default(uuid())
  name            String
  editorialSummary String?  @db.Text
  placeId         String    // Google Places ID
  chatDayId       String
  chatDay         ChatDay   @relation(fields: [chatDayId], references: [id], onDelete: Cascade)
}
